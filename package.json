{
  "name": "magical-cards",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:repro": "node scripts/check-reproducible.mjs",
    "assets:build": "node scripts/build-starter-assets.mjs",
    "assets:check": "node scripts/build-starter-assets.mjs --check",
    "release:check": "node scripts/check-release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "eslint": "10.12.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.14.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.1",
    "yaml": "^2.8.0"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  }
}
